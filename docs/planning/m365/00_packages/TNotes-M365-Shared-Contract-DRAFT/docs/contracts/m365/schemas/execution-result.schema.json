{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "T-Notes M365 Execution Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "script_id",
    "tenant_id",
    "status",
    "data",
    "warnings",
    "errors",
    "started_at_utc",
    "finished_at_utc",
    "duration_ms"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0-draft.1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "script_id": {
      "type": "string",
      "pattern": "^M365\\.[A-Z][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*$"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "success",
        "partial",
        "failed",
        "cancelled"
      ]
    },
    "data": {
      "type": [
        "object",
        "null"
      ]
    },
    "warnings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "retryable": {
            "type": "boolean"
          }
        }
      }
    },
    "started_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "success"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object"
          },
          "errors": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "failed",
              "cancelled"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "errors": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "partial"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "errors": {
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "warnings": {
                "minItems": 1
              }
            }
          }
        ]
      }
    }
  ]
}
