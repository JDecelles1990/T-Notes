{
  "contract_version": "0.3.0",
  "script_id": "M365.SHAREPOINT.ACCESS_DIAGNOSTIC",
  "title": "Inspect SharePoint Online Access & Sign-In Events",
  "description": "Analyze SharePoint Online site authentication events and conditional access outcomes for the target user.",
  "category": "sharepoint",
  "subcategory": "site-access",
  "tags": [
    "sharepoint",
    "sites",
    "permissions",
    "access",
    "graph"
  ],
  "script_path": "sharepoint/access-diagnostic/Get-SharePointAccessDiagnostic.ps1",
  "script_version": "0.3.0",
  "script_sha256": "58b98ee6d0dc270def11afc1970a8c6aee3d697c9338a6f8a0275da7056a379f",
  "supported_powershell": {
    "edition": "Core",
    "minimum_version": "7.4.0"
  },
  "required_modules": [
    {
      "name": "Microsoft.Graph.Reports",
      "minimum_version": "2.0.0"
    }
  ],
  "execution_mode": "isolated_worker",
  "connection_requirements": [
    "Graph"
  ],
  "graph_scopes": [
    "AuditLog.Read.All",
    "Directory.Read.All"
  ],
  "required_roles": [
    {
      "service": "Graph",
      "any_of": [
        "Reports.Reader",
        "Security.Reader"
      ]
    }
  ],
  "risk": "read_only",
  "parameters": [
    {
      "name": "LookbackDays",
      "type": "integer",
      "required": false,
      "minimum": 1,
      "maximum": 30,
      "default": 7,
      "description": "Number of days of events to inspect (1..30)."
    },
    {
      "name": "MaxRecords",
      "type": "integer",
      "required": false,
      "minimum": 1,
      "maximum": 100,
      "default": 10,
      "description": "Maximum number of events to return (1..100)."
    }
  ],
  "expected_output_schema": "schemas/operation-data.schema.json#/$defs/user_signins",
  "timeout_seconds": 45,
  "cancellation_support": "cooperative_then_terminate",
  "data_sensitivity": "restricted",
  "approval_requirements": {
    "explicit_run": true,
    "confirmation_required": false
  },
  "target_policy": {
    "accepted_kinds": [
      "object_id"
    ],
    "requires_resolved_identity": true,
    "output_binding": {
      "object_id_field": "target_user_id",
      "upn_field": null
    }
  }
}
