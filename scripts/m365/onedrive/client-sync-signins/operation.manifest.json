{
  "contract_version": "0.3.0",
  "script_id": "M365.ONEDRIVE.CLIENT_SYNC_SIGNINS",
  "title": "Audit OneDrive Client Sync Sign-Ins",
  "description": "Filter Entra ID sign-in logs for OneDrive SyncEngine, SkyDrive, and SharePoint client sign-ins and auth errors.",
  "category": "onedrive",
  "subcategory": "sync-client",
  "tags": [
    "onedrive",
    "sync",
    "sharepoint",
    "signins",
    "client",
    "graph"
  ],
  "script_path": "onedrive/client-sync-signins/Get-OneDriveClientSyncSignIns.ps1",
  "script_version": "0.3.0",
  "script_sha256": "4886074d33dd45650b8ba135539db6de2dc63c1d2d366498ba70a2ad47f65447",
  "supported_powershell": {
    "edition": "Core",
    "minimum_version": "7.4.0"
  },
  "required_modules": [
    {
      "name": "Microsoft.Graph.Reports",
      "minimum_version": "2.0.0"
    }
  ],
  "execution_mode": "isolated_worker",
  "connection_requirements": [
    "Graph"
  ],
  "graph_scopes": [
    "AuditLog.Read.All"
  ],
  "required_roles": [
    {
      "service": "Graph",
      "any_of": [
        "Reports.Reader",
        "Security.Reader"
      ]
    }
  ],
  "risk": "read_only",
  "parameters": [
    {
      "name": "LookbackDays",
      "type": "integer",
      "required": false,
      "minimum": 1,
      "maximum": 30,
      "default": 14,
      "description": "Number of days of sign-in events to inspect (1..30)."
    },
    {
      "name": "MaxRecords",
      "type": "integer",
      "required": false,
      "minimum": 1,
      "maximum": 100,
      "default": 20,
      "description": "Maximum number of OneDrive/SharePoint client sign-in events to return (1..100)."
    }
  ],
  "expected_output_schema": "schemas/operation-data.schema.json#/$defs/user_signins",
  "timeout_seconds": 45,
  "cancellation_support": "cooperative_then_terminate",
  "data_sensitivity": "restricted",
  "approval_requirements": {
    "explicit_run": true,
    "confirmation_required": false
  },
  "target_policy": {
    "accepted_kinds": [
      "object_id"
    ],
    "requires_resolved_identity": true,
    "output_binding": {
      "object_id_field": "target_user_id",
      "upn_field": null
    }
  }
