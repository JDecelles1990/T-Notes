/* T-Notes Theme — Neon Aurora Glass Dark */

QMainWindow, QDialog {
    background-color: #0b101b;
    color: #e2e8f0;
    font-family: "Segoe UI", "Inter", system-ui, sans-serif;
    font-size: 10pt;
}

/* Glossy Multi-Stop Aurora Gradient Toolbars */
QToolBar {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #1b253b,
        stop: 0.45 #121a2d,
        stop: 1 #0b111f
    );
    border: none;
    border-bottom: 1px solid #263554;
    padding: 3px 6px;
    spacing: 4px;
}

QToolBar::separator {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(56, 189, 248, 0.10),
        stop: 0.5 rgba(129, 140, 248, 0.65),
        stop: 1 rgba(56, 189, 248, 0.10)
    );
    width: 1px;
    margin: 4px 5px;
}

/* Luminous Toolbar Buttons */
QToolButton {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(30, 41, 59, 0.72),
        stop: 1 rgba(15, 23, 42, 0.72)
    );
    color: #dbeafe;
    border: 1px solid rgba(71, 85, 105, 0.55);
    border-radius: 5px;
    padding: 4px 8px;
    font-weight: 600;
}

QToolButton:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(56, 189, 248, 0.24),
        stop: 1 rgba(167, 139, 250, 0.24)
    );
    border: 1px solid #38bdf8;
    color: #ffffff;
}

QToolButton:pressed {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(14, 165, 233, 0.48),
        stop: 1 rgba(139, 92, 246, 0.48)
    );
    border: 1px solid #7dd3fc;
    color: #ffffff;
}

QToolButton:checked {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #0284c7,
        stop: 1 #6366f1
    );
    color: #ffffff;
    border: 1px solid #38bdf8;
}

QToolButton::menu-indicator {
    image: none;
    width: 0px;
}

/* Neon Glass PushButtons */
QPushButton {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #26344e,
        stop: 0.5 #1b253a,
        stop: 1 #131b2c
    );
    color: #e2e8f0;
    border: 1px solid #38bdf8;
    border-color: rgba(56, 189, 248, 0.45);
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 600;
}

QPushButton:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #1e3a5f,
        stop: 1 #312e81
    );
    border: 1px solid #38bdf8;
    color: #ffffff;
}

QPushButton:pressed {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #0369a1,
        stop: 1 #4338ca
    );
    border: 1px solid #7dd3fc;
}

QPushButton:disabled {
    background-color: #131926;
    border-color: #243044;
    color: #64748b;
}

QPushButton#btnPrimary, QPushButton:default {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #0284c7,
        stop: 0.5 #2563eb,
        stop: 1 #7c3aed
    );
    border: 1px solid #7dd3fc;
    color: #ffffff;
}

QPushButton#btnPrimary:hover, QPushButton:default:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #0ea5e9,
        stop: 0.5 #3b82f6,
        stop: 1 #8b5cf6
    );
    border: 1px solid #bae6fd;
}

QPushButton#btnCancel, QPushButton#btnDanger {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #2b1d2e,
        stop: 1 #1b1321
    );
    border: 1px solid rgba(244, 63, 94, 0.5);
    color: #fecdd3;
}

QPushButton#btnCancel:hover, QPushButton#btnDanger:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #4c1d2b,
        stop: 1 #3b1322
    );
    border: 1px solid #fb7185;
    color: #ffffff;
}

/* Tab Widget & Glossy Tabs (blends with TechPadTabBar custom rainbow glow) */
QTabWidget::pane {
    border: 1px solid #24324d;
    border-top: 2px solid #38bdf8;
    background-color: #0e1422;
}

QTabBar {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #141c2e,
        stop: 1 #0b101c
    );
    border-bottom: 1px solid #1f2b44;
}

QTabBar::tab {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #1b2438,
        stop: 1 #121928
    );
    color: #94a3b8;
    border: 1px solid #243047;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 7px 14px;
    margin-right: 3px;
    min-width: 110px;
}

QTabBar::tab:selected {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #24334f,
        stop: 0.45 #172236,
        stop: 1 #0e1422
    );
    color: #f8fafc;
    border-color: #38bdf8;
    font-weight: 700;
}

QTabBar::tab:hover:!selected {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #24314a,
        stop: 1 #182235
    );
    color: #e2e8f0;
    border-color: #475569;
}

/* Note Editor Workspace */
QTextEdit, QPlainTextEdit {
    background-color: #0e1422;
    color: #e2e8f0;
    border: 1px solid #253450;
    border-radius: 6px;
    selection-background-color: #0ea5e9;
    selection-color: #ffffff;
    padding: 6px;
}

QTextEdit:hover, QPlainTextEdit:hover {
    border: 1px solid #38bdf8;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #60a5fa;
    background-color: #101829;
}

/* Glowing Text Fields, Combos & SpinBoxes */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #151f33,
        stop: 1 #0f1728
    );
    color: #f1f5f9;
    border: 1px solid #2e4063;
    border-radius: 6px;
    padding: 5px 9px;
    selection-background-color: #0ea5e9;
    selection-color: #ffffff;
}

QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border: 1px solid #38bdf8;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #19263e,
        stop: 1 #121c30
    );
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #a78bfa;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #1c2944,
        stop: 1 #131d33
    );
    color: #ffffff;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #121a2d;
    color: #e2e8f0;
    border: 1px solid #38bdf8;
    selection-background-color: #1d4ed8;
    selection-color: #ffffff;
    outline: 0;
}

/* Neon History Drawer / Dock Widgets */
QDockWidget {
    color: #e2e8f0;
    font-weight: bold;
    background-color: #0d1322;
}

QDockWidget::title {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #192642,
        stop: 0.5 #151e34,
        stop: 1 #1b2038
    );
    padding: 8px 10px;
    border-bottom: 1px solid #2d3f63;
    color: #7dd3fc;
}

/* Luminous Lists & Trees */
QListWidget, QTreeWidget, QTableWidget {
    background-color: #0f1626;
    color: #e2e8f0;
    border: 1px solid #24334f;
    border-radius: 6px;
    outline: none;
    alternate-background-color: #131c30;
}

QListWidget::item, QTreeWidget::item {
    padding: 7px 10px;
    border-bottom: 1px solid rgba(36, 51, 79, 0.55);
    border-radius: 4px;
}

QListWidget::item:selected, QTreeWidget::item:selected {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(14, 165, 233, 0.35),
        stop: 1 rgba(139, 92, 246, 0.35)
    );
    color: #ffffff;
    border: 1px solid #38bdf8;
}

QListWidget::item:hover:!selected, QTreeWidget::item:hover:!selected {
    background-color: rgba(56, 189, 248, 0.14);
    color: #f8fafc;
}

/* Glass Cards (GroupBox) */
QGroupBox {
    background-color: rgba(15, 23, 42, 0.72);
    border: 1px solid #273859;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 10px;
    font-weight: 600;
    color: #7dd3fc;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    background-color: #0d1424;
    border: 1px solid #2b3f66;
    border-radius: 4px;
    color: #7dd3fc;
}

/* Labels & Statusbar */
QLabel {
    color: #dbeafe;
}

QStatusBar {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #141d31,
        stop: 1 #0a0f1c
    );
    color: #cbd5e1;
    border-top: 1px solid #283959;
    padding: 2px 6px;
}

QStatusBar::item {
    border: none;
}

/* Neon Splitters */
QSplitter::handle {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #172033,
        stop: 0.5 #283b61,
        stop: 1 #172033
    );
    width: 4px;
    height: 4px;
    border-radius: 2px;
}

QSplitter::handle:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #38bdf8,
        stop: 0.5 #a78bfa,
        stop: 1 #34d399
    );
}

/* Luminous Scrollbars */
QScrollBar:vertical {
    background-color: #0c111e;
    width: 11px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #334155,
        stop: 1 #475569
    );
    min-height: 28px;
    border-radius: 5px;
    margin: 1px;
}

QScrollBar::handle:vertical:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #38bdf8,
        stop: 1 #818cf8
    );
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #0c111e;
    height: 11px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #334155,
        stop: 1 #475569
    );
    min-width: 28px;
    border-radius: 5px;
    margin: 1px;
}

QScrollBar::handle:horizontal:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #38bdf8,
        stop: 1 #34d399
    );
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Menus & Tooltips */
QMenu {
    background-color: #101728;
    color: #e2e8f0;
    border: 1px solid #38bdf8;
    border-radius: 6px;
    padding: 5px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #0284c7,
        stop: 1 #6366f1
    );
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #263656;
    margin: 4px 8px;
}

QToolTip {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #090d24,
        stop: 0.45 #180d34,
        stop: 1 #082131
    );
    color: #e0f2fe;
    border: 1.5px solid #38bdf8;
    border-radius: 9px;
    padding: 6px 10px;
}

/* Neon Slider & CheckBoxes */
QSlider::groove:horizontal {
    height: 5px;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #1e293b,
        stop: 1 #0c4a6e
    );
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #06b6d4,
        stop: 1 #8b5cf6
    );
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.6,
        fx: 0.5, fy: 0.5,
        stop: 0 #e0f2fe,
        stop: 0.55 #38bdf8,
        stop: 1 #0284c7
    );
    border: 1px solid #bae6fd;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QCheckBox, QRadioButton {
    color: #e2e8f0;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border-radius: 4px;
    border: 1px solid #475569;
    background-color: #0f172a;
}

QCheckBox::indicator:hover {
    border: 1px solid #38bdf8;
}

QCheckBox::indicator:checked {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #06b6d4,
        stop: 1 #6366f1
    );
    border: 1px solid #7dd3fc;
}
