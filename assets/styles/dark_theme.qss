/* TechPad Clean Technician Dark Theme */

QMainWindow {
    background-color: #1e1e1e;
    color: #cccccc;
}

QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 10pt;
    color: #cccccc;
}

/* ToolBar & Controls */
QToolBar {
    background-color: #252526;
    border: none;
    border-bottom: 1px solid #333333;
    padding: 2px 6px;
    spacing: 4px;
}

/* Suppress 3-dots toolbar overflow extension button */
QToolBarExtension,
QToolButton#qt_toolbar_ext_button {
    width: 0px;
    height: 0px;
    max-width: 0px;
    max-height: 0px;
    padding: 0px;
    margin: 0px;
    border: none;
    background: transparent;
    qproperty-icon: none;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 3px 8px;
    color: #d4d4d4;
    font-weight: 500;
}

QToolButton:hover {
    background-color: #383838;
    border: 1px solid #4a4a4a;
    color: #ffffff;
}

QToolButton:pressed, QToolButton:checked {
    background-color: #0e639c;
    border: 1px solid #1177bb;
    color: #ffffff;
}

QToolButton::menu-indicator {
    image: none;
}

/* Tab Widget & Tab Bar */
QTabWidget::pane {
    border: 1px solid #2d2d2d;
    background-color: #1e1e1e;
    top: -1px;
}

QTabBar {
    background-color: #252526;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background-color: #2d2d2d;
    color: #999999;
    border-top: 2px solid transparent;
    border-bottom: none;
    border-left: 1px solid #252526;
    border-right: 1px solid #252526;
    padding: 7px 16px;
    margin-right: 2px;
    min-width: 100px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #1e1e1e;
    color: #ffffff;
    border-top: 2px solid transparent;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background-color: #333333;
    color: #dddddd;
}

QTabBar::close-button {
    subcontrol-position: right;
    padding: 2px;
    margin-left: 6px;
    border-radius: 2px;
}

QTabBar::close-button:hover {
    background-color: #c42b1c;
    color: #ffffff;
}

QTabBar QToolButton {
    background-color: #252526;
    border: 1px solid #333333;
    border-radius: 3px;
    padding: 2px 4px;
    color: #cccccc;
}

QTabBar QToolButton:hover {
    background-color: #383838;
    color: #ffffff;
}

/* Text Editor */
QTextEdit {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: none;
    padding: 10px;
    selection-background-color: #264f78;
    selection-color: #ffffff;
    line-height: 1.5;
}

/* Dock Widget Splitter & Resize Separator */
QMainWindow::separator {
    background-color: #2d2d2d;
    width: 6px;
    height: 6px;
}

QMainWindow::separator:hover {
    background-color: #007acc;
}

/* History / Archive Drawer */
QDockWidget {
    color: #ffffff;
    font-weight: bold;
    titlebar-close-icon: none;
}

QDockWidget::title {
    background-color: #252526;
    padding: 6px;
    border-bottom: 1px solid #333333;
}

QLineEdit {
    background-color: #2d2d2d;
    color: #ffffff;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 6px 10px;
    selection-background-color: #264f78;
}

QLineEdit:focus {
    border: 1px solid #007acc;
}

QListWidget {
    background-color: #1e1e1e;
    color: #cccccc;
    border: 1px solid #2d2d2d;
    border-radius: 4px;
    padding: 4px;
}

QListWidget::item {
    border-bottom: 1px solid #282828;
    padding: 8px 6px;
    border-radius: 4px;
}

QListWidget::item:hover {
    background-color: #2a2d2e;
    color: #ffffff;
}

QListWidget::item:selected {
    background-color: #094771;
    color: #ffffff;
}

/* Dialogs & Push Buttons */
QDialog {
    background-color: #252526;
    color: #ffffff;
}

QLabel {
    color: #cccccc;
}

QPushButton {
    background-color: #0e639c;
    color: #ffffff;
    border: 1px solid #1177bb;
    border-radius: 4px;
    padding: 6px 14px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #1177bb;
}

QPushButton:pressed {
    background-color: #0b5180;
}

QPushButton:disabled {
    background-color: #333333;
    border-color: #444444;
    color: #666666;
}

QPushButton#btnCancel, QPushButton#btnSecondary {
    background-color: #3e3e42;
    border-color: #555555;
    color: #dddddd;
}

QPushButton#btnCancel:hover, QPushButton#btnSecondary:hover {
    background-color: #4e4e52;
    color: #ffffff;
}

QPushButton#btnDanger {
    background-color: #a4262c;
    border-color: #c42b1c;
    color: #ffffff;
}

QPushButton#btnDanger:hover {
    background-color: #c42b1c;
}

/* Status Bar */
QStatusBar {
    background-color: #181818;
    color: #999999;
    border-top: 1px solid #2d2d2d;
    font-size: 9pt;
}

QStatusBar QLabel {
    color: #999999;
    padding: 2px 8px;
}

/* Context Menus */
QMenu {
    background-color: #252526;
    border: 1px solid #3c3c3c;
    color: #cccccc;
    padding: 4px;
}

QMenu::item {
    padding: 5px 20px 5px 20px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #094771;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #333333;
    margin: 4px 6px;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #1e1e1e;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #424242;
    min-height: 25px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #555555;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

